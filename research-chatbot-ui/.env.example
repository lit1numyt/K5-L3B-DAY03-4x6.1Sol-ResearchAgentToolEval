# --- Web app settings ---
BOT_PROVIDER=openai
BOT_MODEL=
HISTORY_WINDOW=5
MAX_TOOL_ROUNDS=4
HOST=127.0.0.1
PORT=8000
# Set to 1 locally to enable /docs. Keep 0 for public demos.
ENABLE_DOCS=0
LOG_LEVEL=INFO
# Override if your files live elsewhere
# SYSTEM_PROMPT_PATH=artifacts/system_prompt.md
# TOOLS_PATH=artifacts/tools.yaml

# --- Provider credentials ---
# Use the EXACT variable names your existing provider implementation expects
# (e.g. OPENAI_API_KEY=...). Do not commit real keys.
